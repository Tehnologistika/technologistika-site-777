# Режим работы Express-сервера
NODE_ENV=production

# Порт, на котором слушает Express-сервер
PORT=3000

# Основной домен сайта
SITE_DOMAIN=технологист.рф

# Адрес внешнего API (поддомен ayub)
AYUB_API_URL=https://ayub.технологист.рф

# Файл SQLite на этом же сервере. Первая запись персональных данных — сюда.
# Каталог должен быть доступен на запись пользователю сервиса.
LEADS_DB_PATH=./data/leads.sqlite

# Срок хранения заявок в основной базе, в днях (политика: не больше 6 месяцев).
LEADS_RETENTION_DAYS=183

# Токен доступа к /admin и GET /api/admin/leads. Без него админка отвечает 503.
# Не коммитить значение. Длинная случайная строка.
ADMIN_TOKEN=

# Сигнал в Telegram без персональных данных. Пока false — в Telegram ничего не уходит.
# true / 1 / yes включает сообщение вида «Новая заявка №T-0001, откройте админку».
TELEGRAM_NOTIFY=false

# Нужны только если TELEGRAM_NOTIFY=true. В сообщение не попадают имя, телефон, маршрут и комментарий.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
